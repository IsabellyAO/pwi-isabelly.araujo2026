programa
{
	
	funcao inicio()
	{
		inteiro matriz [3][5] // Cria a matriz

			para (inteiro n = 0 ; n<=2 ; n ++) {

				para (inteiro y = 0 ; y<=4 ; y ++) {
					matriz[n][y]=0
				}
			}

		inteiro xescolha = 5
		enquanto (xescolha !=3) {

			escreva("1. Inserir")
			
		}
	}
}
